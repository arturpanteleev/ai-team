# Per-package coverage floors (ratchet: only raise, never lower).
# Baseline measured on the CI toolchain pinned in .github/workflows/ci.yaml
# (Go 1.26.6) with `go test -coverprofile=coverage.out ./...` + coverage-gate.sh:
#   approval 76.98  checks 71.75  delivery 67.16  evidence 62.59
#   pipeline 74.23  safeio 72.67
# Floors keep a ~0.4pp margin below the measured baseline so the gate is
# stable across Go patch/toolchain differences (Go 1.27 measures pipeline
# at 75.9 — instrumented statement counts differ between Go releases).
PKG_APPROVAL_FLOOR=75.7
PKG_CHECKS_FLOOR=64.6
PKG_DELIVERY_FLOOR=66.8
PKG_EVIDENCE_FLOOR=61.9
PKG_PIPELINE_FLOOR=73.8
PKG_SAFEIO_FLOOR=60.0
